<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <OutputType>Library</OutputType>
        <LangVersion>preview</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
        <PackageReference Include="MongoDB.Driver" Version="3.11.2" />
        <PackageReference Include="nunit" Version="4.6.1" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
        <PackageReference Include="SkiaSharp" Version="4.152.0" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.152.0" />
        <PackageReference Update="FSharp.Core" Version="10.1.401" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Weekly.fs" />
        <Compile Include="TweetsFromMongo.fs" />
        <Compile Include="FsAdvent.fs" />
        <Compile Include="FsHeroes.fs" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\FSharp.Weekly.FunctionApp\FSharp.Weekly.FunctionApp.fsproj" />
    </ItemGroup>

</Project>
